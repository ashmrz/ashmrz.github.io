{
  "name": "ashmrz-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build && npm run verify:dist",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs && node --check js/script.js",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "6.6.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.0"
  }
}
